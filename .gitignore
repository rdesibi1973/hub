
# NetBeans build artifacts
NetBeansProjects/*/build/
NetBeansProjects/*/dist/
NetBeansProjects/*/nbproject/private/
SavannahExplorersGUI/

# Server-only config (contains live DB credentials — never commit)
includes/config.php

# PHP error logs (server-generated, not source files)
error_log
**/error_log

# Conflicted copies (Dropbox sync artifacts)
**/*conflicted copy*.php

# Claude Code worktrees (local dev tool artifacts — never commit)
.claude/

# ITI uploads — files live on server only; keep folder structure, ignore content
modules/iti/uploads/logo/*
modules/iti/uploads/profiles/*
!modules/iti/uploads/logo/.gitkeep
!modules/iti/uploads/profiles/.gitkeep
!modules/iti/uploads/.htaccess
