package SavannahExplorers.BackOffice;
/**
 *
 * @author rdesibi
 */
import javax.swing.*;
import java.awt.*;
import java.awt.event.ActionEvent;
import java.nio.file.Path;
import java.time.LocalDate;
import java.util.ArrayList;
import java.util.List;

public class BackOfficeMain extends JFrame {

    private JTextField txtRoot;
    private JTextField txtName;
    private JTextField txtContent;
    private JCheckBox chkIgnoreCase;
    private JButton btnSearch;
    private JList<String> resultList;
    private DefaultListModel<String> listModel;
    private JProgressBar progressBar;

    public BackOfficeMain() {
        initUI();
    }

    private void initUI() {

        setTitle("Back Office Search");
        setSize(800, 600);
        setDefaultCloseOperation(EXIT_ON_CLOSE);
        setLocationRelativeTo(null);

        JPanel panel = new JPanel(new BorderLayout(10, 10));

        JPanel topPanel = new JPanel(new GridLayout(5, 2, 5, 5));

        txtRoot = new JTextField();
        txtName = new JTextField();
        txtContent = new JTextField();
        chkIgnoreCase = new JCheckBox("Ignore Case");
        btnSearch = new JButton("Search");

        topPanel.add(new JLabel("Root Path:"));
        topPanel.add(txtRoot);
        topPanel.add(new JLabel("File Name:"));
        topPanel.add(txtName);
        topPanel.add(new JLabel("Content:"));
        topPanel.add(txtContent);
        topPanel.add(chkIgnoreCase);
        topPanel.add(new JLabel());
        topPanel.add(btnSearch);

        progressBar = new JProgressBar();
        progressBar.setIndeterminate(false);

        listModel = new DefaultListModel<>();
        resultList = new JList<>(listModel);

        panel.add(topPanel, BorderLayout.NORTH);
        panel.add(new JScrollPane(resultList), BorderLayout.CENTER);
        panel.add(progressBar, BorderLayout.SOUTH);

        add(panel);

        btnSearch.addActionListener(this::startSearch);
    }

    private void startSearch(ActionEvent e) {

        listModel.clear();
        progressBar.setIndeterminate(true);

        String rootPath = txtRoot.getText();
        String name = txtName.getText();
        String content = txtContent.getText();
        boolean ignoreCase = chkIgnoreCase.isSelected();

        SwingWorker<List<Path>, Void> worker = new SwingWorker<>() {

            @Override
            protected List<Path> doInBackground() throws Exception {

                List<FileMatcher> matchers = new ArrayList<>();

                if (name != null && !name.isBlank()) {
                    matchers.add(new NameMatcher(
                            name,
                            MatchType.CONTAINS,
                            ignoreCase
                    ));
                }

                if (content != null && !content.isBlank()) {
                    matchers.add(new ContentMatcher(
                            content,
                            ignoreCase
                    ));
                }

                FileSearchEngine engine = new FileSearchEngine();

                return engine.search(Path.of(rootPath), matchers);
            }

            @Override
            protected void done() {
                try {
                    List<Path> results = get();
                    results.forEach(p ->
                            listModel.addElement(p.toString())
                    );
                } catch (Exception ex) {
                    JOptionPane.showMessageDialog(
                            BackOfficeMain.this,
                            "Error: " + ex.getMessage(),
                            "Search Error",
                            JOptionPane.ERROR_MESSAGE
                    );
                } finally {
                    progressBar.setIndeterminate(false);
                }
            }
        };

        worker.execute();
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() ->
                new BackOfficeMain().setVisible(true)
        );
    }
}
